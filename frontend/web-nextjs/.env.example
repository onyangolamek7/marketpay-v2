# Frontend configuration. Only non-secret values belong here.
#
# The browser never talks to the API Gateway directly: it calls this app's own
# /api/v1 route, which attaches the session and forwards upstream. That is why
# the gateway URL below is a server-only variable with no NEXT_PUBLIC_ prefix.
#
# Never put a Django secret key, database or Redis credentials, Africa's Talking
# or M-Pesa credentials, a JWT signing key or Vault credentials in this file or
# in any NEXT_PUBLIC_ variable — those reach the browser bundle. Production
# secrets live in HashiCorp Vault per the platform's secret-management policy.

# Base URL of the Django API Gateway (server-side only).
API_GATEWAY_URL=http://localhost:8000

# Legacy fallback used when API_GATEWAY_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Development only. Set to 1 to serve /api/v1/auth/* from the in-memory mock in
# lib/auth/mock-gateway.ts instead of the gateway. Ignored in production builds.
# OTP codes are printed to the server terminal, never to the browser.
AUTH_MOCK=0
